		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "FOMOlessDF"
		},
		"AzureDatabricks1_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'AzureDatabricks1'"
		},
		"LS_ADLS_fomoless_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_fomoless'"
		},
		"devto_source_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'devto_source'"
		},
		"linkedserv_fomoless_adls_MOUATH_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkedserv_fomoless_adls_MOUATH'"
		},
		"LS_ADLS_fomoless_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sdadataengbootcamp4mou.dfs.core.windows.net/"
		},
