{
	"name": "TrialforPipe_26Sep",
	"properties": {
		"description": "Orchestrator. Runs PL_Ingest_Source_Generic once per source, landing raw bytes at raw/<sourceName>/ in the fomoless container. The 8 keyless sources run through the ForEach using sourceConfigs; The Guardian runs as its own activity because it needs an API key that must never be hardcoded into this pipeline. Each critical Databricks stage notifies the failure Logic App on failure, naming the stage that broke.",
		"activities": [
			{
				"name": "ForEachSource",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.sourceConfigs",
						"type": "Expression"
					},
					"isSequential": false,
					"batchCount": 8,
					"activities": [
						{
							"name": "IngestSource",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Ingest_Source_Generic",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"sourceName": {
										"value": "@item().sourceName",
										"type": "Expression"
									},
									"baseUrl": {
										"value": "@item().baseUrl",
										"type": "Expression"
									},
									"relativeUrl": {
										"value": "@item().relativeUrl",
										"type": "Expression"
									},
									"fileExtension": {
										"value": "@item().fileExtension",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Ingest_HackerNews",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:05:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "BinarySource",
						"storeSettings": {
							"type": "HttpReadSettings",
							"requestMethod": "GET"
						},
						"formatSettings": {
							"type": "BinaryReadSettings"
						}
					},
					"sink": {
						"type": "BinarySink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_HTTP_Binary_Raw",
						"type": "DatasetReference",
						"parameters": {
							"baseUrl": {
								"value": "https://hn.algolia.com",
								"type": "Expression"
							},
							"relativeUrl": {
								"value": "@concat('/api/v1/search_by_date?query=data+engineering&tags=story&hitsPerPage=1000&numericFilters=created_at_i%3E', string(div(sub(ticks(addDays(utcnow(), -30)), 621355968000000000), 10000000)))",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_Binary_Raw",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@concat('raw/hackernews')",
								"type": "Expression"
							},
							"fileName": {
								"value": "@concat('hackernews_', formatDateTime(utcnow(), 'yyyyMMdd_HHmmss'), '.json')",
								"type": "Expression"
							}
						}
					}
				]
			},
